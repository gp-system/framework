package http

import (
	"context"
	"errors"
	"net/http"

	gen "{{.GoModule}}/internal/modules/{{.Module}}/surfaces/{{.Surface}}/http/gen"
	"{{.GoModule}}/internal/modules/{{.Module}}/surfaces/{{.Surface}}/http/mapper"
	"{{.GoModule}}/internal/modules/{{.Module}}/surfaces/{{.Surface}}/service"
)

// ResetPassword handles POST {{.BasePath}}/password/reset.
func (h *Handler) ResetPassword(ctx context.Context, req gen.ResetPasswordRequest) (gen.ResetPasswordResponse, error) {
	err := h.svc.ResetPassword(ctx, req.Body.Token, req.Body.Password)
	if errors.Is(err, service.ErrInvalidToken) {
		return gen.ResetPassword401JSONResponse(mapper.Problem(http.StatusUnauthorized, "invalid or expired reset token")), nil
	}
	if err != nil {
		return nil, err
	}
	return gen.ResetPassword204Response{}, nil
}
