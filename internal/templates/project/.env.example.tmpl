# Copy to .env for local development.

LISTEN_ADDR=:3000
SHUTDOWN_TIMEOUT=10s
CORS_ORIGINS=*

# HTTP server timeouts (Slowloris defense). WRITE_TIMEOUT stays 0 so streaming
# responses aren't capped; set it if all your endpoints are short-lived.
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=30s
WRITE_TIMEOUT=0s
IDLE_TIMEOUT=120s

# Expose internal error detail/stack/chain in 5xx responses. DEV ONLY, never
# enable in production. Decoupled from OTEL_DEV_MODE on purpose.
HTTP_EXPOSE_INTERNAL_ERRORS=true

# Telemetry: dev mode logs to stdout, no OTLP endpoint needed.
OTEL_DEV_MODE=true
OTEL_SERVICE_NAME={{.Project}}
LOG_LEVEL=DEBUG

# Console log format. monolog = PHP/Monolog-style lines with full-path stack
# traces (readable for PHP developers); leave empty/unset for the default slog
# text (dev) / JSON (prod) output. Also applies with LOG_STDOUT in production.
LOG_FORMAT=monolog

# Sentry (optional). Set a DSN to capture 5xx and failed-task errors with the
# full request trace (HTTP + DB queries with timings) attached. Works in dev
# mode too. Sampling follows OTEL_TRACES_SAMPLER; set SENTRY_TRACES=false to
# ship spans to Sentry via a collector instead.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# PostgreSQL (matches compose.yml; DB_HOST is the compose service name)
DB_HOST=postgres
DB_PORT=5432
DB_USER={{.Project}}
DB_PASSWORD={{.Project}}
DB_NAME={{.Project}}
DB_SSLMODE=disable

# Valkey + background worker (cmd/worker; VALKEY_ADDR is the compose service name)
VALKEY_ADDR=valkey:6379
WORKER_CONCURRENCY=10

# Host UID/GID the dev containers run as, so files written into the
# bind-mounted source belong to you, not root. Set to `id -u` / `id -g`.
USER_ID=1000
GROUP_ID=1000

# Traefik-facing hostnames (proxynet, no published ports).
APP_HOST={{.Project}}.localhost
MAILPIT_HOST=mailpit.{{.Project}}.localhost
RUSTFS_CONSOLE_HOST=rustfs-console.{{.Project}}.localhost
RUSTFS_S3_HOST=rustfs.{{.Project}}.localhost

# Mail (mailpit; wire smtp.Config into your project's config to use these)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TLS=none
MAIL_AUTH=none
MAIL_FROM_ADDRESS=no-reply@{{.Project}}.localhost

# S3-compatible object storage (rustfs; wire s3.Config into your project's
# config to use these)
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET={{.Project}}
S3_ACCESS_KEY={{.Project}}
S3_SECRET_KEY={{.Project}}-secret
S3_USE_PATH_STYLE=true

# gpsystem:env
