{{- end}}
{{- if .HasSocialProvider "facebook"}}
OAuthFacebookClientID     string `env:"OAUTH_FACEBOOK_CLIENT_ID,required"`
OAuthFacebookClientSecret string `env:"OAUTH_FACEBOOK_CLIENT_SECRET,required"`
{{- end}}
{{- if .HasSocialProvider "google"}}
OAuthGoogleClientID     string `env:"OAUTH_GOOGLE_CLIENT_ID,required"`
OAuthGoogleClientSecret string `env:"OAUTH_GOOGLE_CLIENT_SECRET,required"`
{{- end}}
{{- if .HasSocialProvider "apple"}}
OAuthAppleClientID   string `env:"OAUTH_APPLE_CLIENT_ID,required"`
OAuthAppleTeamID     string `env:"OAUTH_APPLE_TEAM_ID,required"`
