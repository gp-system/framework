package http

import (
	"context"

	gen "{{.GoModule}}/internal/modules/{{.Module}}/surfaces/{{.Surface}}/http/gen"
)

// ForgotPassword handles POST {{.BasePath}}/password/forgot.
//
// Always responds 204, whether or not the email is registered: this avoids
// leaking which addresses have an account.
func (h *Handler) ForgotPassword(ctx context.Context, req gen.ForgotPasswordRequest) (gen.ForgotPasswordResponse, error) {
	if err := h.svc.ForgotPassword(ctx, req.Body.Email); err != nil {
		return nil, err
	}
	return gen.ForgotPassword204Response{}, nil
}
