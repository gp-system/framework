func (r *pgRepository) GetRoles(ctx context.Context, userID string) ([]string, error) {
	rows, err := r.db.Query(ctx, `
		SELECT ro.name FROM user_roles ur
		JOIN roles ro ON ro.id = ur.role_id
		WHERE ur.user_id::text = $1 ORDER BY ro.name`, userID)
	if err != nil {
		return nil, errs.Wrap(err, "{{.Module}}: roles")
	}
	defer rows.Close()

	var roles []string
	for rows.Next() {
		var role string
		if err := rows.Scan(&role); err != nil {
			return nil, errs.Wrap(err, "{{.Module}}: roles scan")
		}
		roles = append(roles, role)
	}
	return roles, rows.Err()
}

func (r *pgRepository) GetPermissions(ctx context.Context, userID string) ([]string, error) {
	rows, err := r.db.Query(ctx, `
		SELECT DISTINCT p.name
		FROM user_roles ur
		JOIN role_permissions rp ON rp.role_id = ur.role_id
		JOIN permissions p ON p.id = rp.permission_id
		WHERE ur.user_id::text = $1
		ORDER BY p.name`, userID)
	if err != nil {
		return nil, errs.Wrap(err, "{{.Module}}: permissions")
	}
	defer rows.Close()

	var permissions []string
	for rows.Next() {
		var permission string
		if err := rows.Scan(&permission); err != nil {
			return nil, errs.Wrap(err, "{{.Module}}: permissions scan")
		}
		permissions = append(permissions, permission)
	}
	return permissions, rows.Err()
}

