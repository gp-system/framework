// repository.go implements the {{.Module}} module's repository with hand-written pgx
// queries. It receives a pg.DBTX: inside a Transactor closure the same call
// transparently runs on the transaction carried by the context.
package repository

import (
	"context"
	"time"

	"github.com/gp-system/dbx/pg"
	"{{.Errs.Path}}"
	"github.com/jackc/pgx/v5"
)

type pgRepository struct {
	db pg.DBTX
}

func New(db pg.DBTX) *pgRepository {
	return &pgRepository{db: db}
}

var _ Repository = (*pgRepository)(nil)

func (r *pgRepository) InsertUser(ctx context.Context, name, email string) (string, error) {
	var id string
	err := r.db.QueryRow(ctx, `
		INSERT INTO users (name, email) VALUES ($1, $2) RETURNING uuid`, name, email).Scan(&id)
	if err != nil {
		return "", errs.Wrap(err, "{{.Module}}: insert user")
	}
	return id, nil
}

func (r *pgRepository) InsertCredential(ctx context.Context, userID, passwordHash string) error {
	_, err := r.db.Exec(ctx, `
		INSERT INTO auth_credentials (user_id, provider, provider_key)
		VALUES ($1, 'local', $2)`, userID, passwordHash)
	if err != nil {
		return errs.Wrap(err, "{{.Module}}: insert credential")
	}
	return nil
}

func (r *pgRepository) UpdateCredentialPassword(ctx context.Context, userID, passwordHash string) error {
	_, err := r.db.Exec(ctx, `
		UPDATE auth_credentials SET provider_key = $2
		WHERE user_id::text = $1 AND provider = 'local'`, userID, passwordHash)
	if err != nil {
		return errs.Wrap(err, "{{.Module}}: update credential password")
	}
	return nil
}

func (r *pgRepository) AssignRole(ctx context.Context, userID, role string) error {
	_, err := r.db.Exec(ctx, `
		INSERT INTO user_roles (user_id, role_id)
		SELECT $1, id FROM roles WHERE name = $2
		ON CONFLICT DO NOTHING`, userID, role)
	if err != nil {
		return errs.Wrap(err, "{{.Module}}: assign role")
	}
	return nil
}

func (r *pgRepository) GetUserByID(ctx context.Context, id string) (*User, error) {
	var u User
	var emailVerifiedAt *time.Time
	err := r.db.QueryRow(ctx, `
		SELECT uuid, name, email, email_verified_at FROM users
		WHERE uuid::text = $1 AND deleted_at IS NULL`, id).
		Scan(&u.ID, &u.Name, &u.Email, &emailVerifiedAt)
	if err == pgx.ErrNoRows {
		return nil, nil
	}
	if err != nil {
		return nil, errs.Wrap(err, "{{.Module}}: get user")
	}
	u.EmailVerified = emailVerifiedAt != nil
	return &u, nil
}

func (r *pgRepository) GetCredentialByEmail(ctx context.Context, email string) (*Credential, error) {
	var c Credential
	var emailVerifiedAt *time.Time
	err := r.db.QueryRow(ctx, `
		SELECT u.uuid, u.name, u.email, u.email_verified_at, cr.provider_key
		FROM users u
		JOIN auth_credentials cr ON cr.user_id = u.uuid AND cr.provider = 'local'
		WHERE u.email = $1 AND u.deleted_at IS NULL`, email).
		Scan(&c.ID, &c.Name, &c.Email, &emailVerifiedAt, &c.PasswordHash)
	if err == pgx.ErrNoRows {
		return nil, nil
	}
	if err != nil {
		return nil, errs.Wrap(err, "{{.Module}}: get credential")
	}
	c.EmailVerified = emailVerifiedAt != nil
	return &c, nil
}

