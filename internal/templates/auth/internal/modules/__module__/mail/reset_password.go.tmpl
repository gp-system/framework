package mail

import (
	"context"
	"embed"

	kitmail "github.com/gp-system/mail"
)

//go:embed templates/reset_password.html.tmpl templates/reset_password.txt.tmpl
var resetPasswordTemplatesFS embed.FS

// ResetPasswordMail is the payload rendered into the reset_password templates.
type ResetPasswordMail struct {
	// Name is the account holder's display name.
	Name string
	// Link is the absolute reset URL: AppBaseURL + "/reset-password?token=...".
	Link string
}

// ResetPasswordNotifier sends the password-reset link created at
// ForgotPassword. The injected kitmail.Mailer is the kit's transport seam:
// SMTP in production (smtp.NewIfConfigured/MustNewIfConfigured),
// kitmail.NewDiscard() in dev without a mail server configured,
// kitmail.NewMemory() in tests.
type ResetPasswordNotifier struct {
	mailer kitmail.Mailer
}

// NewResetPasswordNotifier builds a ResetPasswordNotifier over m.
func NewResetPasswordNotifier(m kitmail.Mailer) *ResetPasswordNotifier {
	return &ResetPasswordNotifier{mailer: m}
}

// Notify renders the templates with p and sends the result to to.
func (n *ResetPasswordNotifier) Notify(ctx context.Context, to string, p ResetPasswordMail) error {
	msg := kitmail.NewMessage().
		WithTo(to).
		WithSubject("Reset your password").
		WithBody(kitmail.Template(resetPasswordTemplatesFS, "templates/reset_password.html.tmpl", p).
			WithTextTemplate("templates/reset_password.txt.tmpl"))
	return n.mailer.Send(ctx, msg)
}
